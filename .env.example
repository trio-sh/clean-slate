# Supabase Configuration
VITE_SUPABASE_URL="your_supabase_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Stripe Connect Configuration (Platform Model)
# This is YOUR Pipilot Stripe secret key with Connect enabled
STRIPE_PLATFORM_SECRET_KEY="sk_live_YOUR_PIPILOT_KEY_HERE"

# This is the publishable key from YOUR Pipilot account
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_PIPILOT_PUBLISHABLE_KEY"

# Amani Cleaners connected account ID (generated after running setup-stripe-connect.js)
STRIPE_CONNECTED_ACCOUNT_ID="acct_XXXXXXXXXX"

# Commission Structure
# Option 1: Percentage-based fee (e.g., 10 = 10% commission)
STRIPE_PLATFORM_FEE_PERCENT="1"

# Option 2: Fixed fee per transaction (in CAD, e.g., 2.50 = $2.50 per transaction)
STRIPE_PLATFORM_FEE_FIXED="0"

# Webhook Secret
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# Email (SMTP — used by /api/send-email). Server-side only; do NOT prefix with VITE_.
# SMTP_PASSWORD is a secret (Gmail App Password) — set it in your host, never commit it.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="amaniscleaners@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
SMTP_FROM_NAME="Amani's Cleaners"
SMTP_FROM_EMAIL="info@amanicleaners.com"
SMTP_REPLY_TO="info@amanicleaners.com"

# App URL
VITE_APP_URL="https://amanicleaners.com"

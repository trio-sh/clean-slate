# Amani's Cleaners - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# SUPABASE (for live mode)
# ===========================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# App Mode: 'demo' (uses IndexedDB) or 'live' (uses Supabase)
VITE_APP_MODE=demo

# ===========================================
# SMS (Infobip) - Optional
# ===========================================
# Get credentials from https://portal.infobip.com
# 1. Sign up at Infobip
# 2. Go to API Keys section to get your API Key
# 3. Your Base URL is shown in account settings (e.g., k93mj3.api.infobip.com)
# 4. Set a sender name (up to 11 alphanumeric characters)
#
# See docs/SMS_EMAIL_SETUP.md for detailed instructions
VITE_INFOBIP_BASE_URL=https://k93mj3.api.infobip.com
VITE_INFOBIP_API_KEY=your_api_key_here
VITE_INFOBIP_SENDER=AmaniClean

# ===========================================
# EMAIL (EmailJS) - Optional
# ===========================================
# Get credentials from https://www.emailjs.com
# See docs/SMS_EMAIL_SETUP.md for detailed instructions
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXX

# ===========================================
# NOTES
# ===========================================
# - The app works in "demo" mode by default without any API keys
# - Demo mode uses IndexedDB for local storage
# - SMS/Email in demo mode logs to console instead of sending
# - All features work in demo mode for testing
